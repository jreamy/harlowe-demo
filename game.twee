:: StoryStylesheet [stylesheet]
tw-sidebar {
  display: none;
}

.battle-img {
  width: 150px;
}

.battle {
  text-align: center;
}

.container {
    display: flex;
    justify-content: space-between; /* Pushes items to the edges */
    align-items: center; /* Vertically centers items (optional) */
    width: 100%; /* Ensure container spans the full width */
}